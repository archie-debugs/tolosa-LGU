# Example .env for local development

# Required: PostgreSQL connection for the application database.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<database>

# Required: long random secret used to sign login tokens, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# First Super Administrator, created at startup only while no active Super Administrator exists.
# Existing accounts are never modified. Password must be at least 8 characters.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Permanent folder for uploaded document files. Defaults to %LOCALAPPDATA%\sb_tolosa_tracking\documents.
# Back this folder up together with the database.
DOCUMENT_STORAGE_DIR=

# Local LAN development settings
DEV_HTTP=1
PORT=8001
# Empty host makes Flet advertise localhost while Uvicorn binds all interfaces.
FRONTEND_HOST=
FRONTEND_PORT=8550
FRONTEND_PUBLIC_URL=

# Existing FastAPI QR lookup route (use the backend port, not the Flet port)
PUBLIC_BASE_URL=

# When DEV_HTTP=1, refresh private-IP public URLs from the active LAN adapter at startup.
AUTO_DETECT_LAN_IP=1

# Public URL for the scanner frontend (used to build QR targets)
# SCANNER_PUBLIC_URL=https://127.0.0.1:8002

# Optional override for backend URL used by frontends
# BACKEND_URL=http://127.0.0.1:8001

# Flet upload settings
# FLET_SECRET_KEY=your_secret_key_here
# FLET_UPLOAD_HANDLER_ENDPOINT=upload
